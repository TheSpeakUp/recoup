# Copy to .env and fill in. Leave a key empty to use the offline mock for that part.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...      # printed by: stripe listen --forward-to localhost:8000/webhooks/stripe
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5-5
SCENARIO=recovery                   # or collections, payables
CURRENCY=gbp
USE_COGNEE=0                         # 1 = Cognee memory (side quest), needs `pip install cognee` + its LLM key
RESET_ON_START=1                     # fresh DB on every start, handy for demos
